{
  "version": "1.0",
  "description": "Hard constraints for the menswear recommendation engine. These are non-negotiable guardrails — MUST and MUST_NOT rules that prevent embarrassing or clearly wrong recommendations.",
  "constraint_types": {
    "must_not": "This combination should NEVER be recommended",
    "must": "This requirement is mandatory for the given condition",
    "avoid": "Strongly discouraged — override only if user explicitly requests"
  },
  "constraints": [

    {"id": "C001", "type": "must_not", "category": "body_fit",
     "condition": {"D01.build": ["heavy", "stocky"]},
     "restriction": {"D04.tshirt_fit": "muscle"},
     "reason": "Muscle fit on heavy/stocky build creates unflattering tight look. Flusser: 'Nothing like the look of a stuffed sausage.'",
     "style_track": ["casual", "smart_casual"]},

    {"id": "C002", "type": "must_not", "category": "body_fit",
     "condition": {"D01.build": ["heavy", "stocky"]},
     "restriction": {"D04.jeans_fit": ["skinny", "slim"]},
     "reason": "Skinny/slim jeans on heavy build accentuate width contrast between torso and legs.",
     "style_track": ["casual", "smart_casual"]},

    {"id": "C003", "type": "must_not", "category": "body_fit",
     "condition": {"D01.build": "slim"},
     "restriction": {"D04.tshirt_fit": "oversized"},
     "reason": "Oversized on slim frame makes the wearer look smaller and swimming in fabric.",
     "style_track": ["casual"]},

    {"id": "C004", "type": "avoid", "category": "body_fit",
     "condition": {"D01.height": "short"},
     "restriction": {"D04.shorts_length": "below_knee"},
     "reason": "Below-knee shorts on short men visually shorten the leg line further.",
     "style_track": ["casual"]},

    {"id": "C005", "type": "avoid", "category": "body_fit",
     "condition": {"D01.height": "short"},
     "restriction": {"D02.top_bottom_contrast": "high_contrast"},
     "reason": "High contrast between top and bottom halves divides the figure, shortening apparent height. Flusser: the suit's ultimate color lesson for short men is monochrome.",
     "style_track": ["casual", "smart_casual", "business_casual", "business_formal"]},

    {"id": "C006", "type": "must_not", "category": "body_fit",
     "condition": {"D01.build": "heavy"},
     "restriction": {"D04.tshirt_fit": "slim"},
     "reason": "Slim fit on heavy build creates visible tension lines and unflattering silhouette.",
     "style_track": ["casual", "smart_casual"]},

    {"id": "C007", "type": "avoid", "category": "body_proportion",
     "condition": {"D01.body_shape": "inverted_triangle"},
     "restriction": {"D04.jacket_shoulder_type": "structured_padded"},
     "reason": "Already-broad shoulders don't need additional width from structured padding. Use natural/soft shoulders instead.",
     "style_track": ["smart_casual", "business_casual", "business_formal"]},

    {"id": "C008", "type": "avoid", "category": "body_proportion",
     "condition": {"D01.build": "heavy"},
     "restriction": {"D02.pattern_scale": "micro"},
     "reason": "Micro patterns make the body appear larger in comparison. Heavy build should use medium to large scale patterns.",
     "style_track": ["casual", "smart_casual", "business_casual", "business_formal"]},

    {"id": "C009", "type": "must", "category": "body_proportion",
     "condition": {"D01.face_shape": "wide_broad"},
     "restriction": {"D04.shirt_collar_style": ["straight_point", "tab", "pinned"]},
     "reason": "Wide face needs narrowing collar styles. Spread/cutaway collars would widen the face further. Flusser: collar frames the face like a picture frame.",
     "style_track": ["smart_casual", "business_casual", "business_formal"]},

    {"id": "C010", "type": "must", "category": "body_proportion",
     "condition": {"D01.face_shape": "thin_narrow"},
     "restriction": {"D04.shirt_collar_style": ["spread", "cutaway"]},
     "reason": "Narrow face needs widening collar styles to balance proportions.",
     "style_track": ["smart_casual", "business_casual", "business_formal"]},

    {"id": "C011", "type": "must_not", "category": "color",
     "condition": {"D03.skin_undertone": "warm"},
     "restriction": {"D03.metal_compatibility": "silver"},
     "reason": "Silver on warm undertone creates sickly greenish appearance. Gold harmonizes with warm skin.",
     "style_track": ["casual", "smart_casual", "business_casual", "business_formal"]},

    {"id": "C012", "type": "must_not", "category": "color",
     "condition": {"D03.skin_undertone": "cool"},
     "restriction": {"D03.metal_compatibility": "gold"},
     "reason": "Gold on cool undertone makes skin appear yellowish. Silver harmonizes with cool skin.",
     "style_track": ["casual", "smart_casual", "business_casual", "business_formal"]},

    {"id": "C013", "type": "must_not", "category": "color",
     "condition": {"D03.overall_contrast": "low"},
     "restriction": {"D03.outfit_contrast_level": "high_outfit_contrast"},
     "reason": "High outfit contrast overpowers low-contrast features (all light or all dark). Face gets lost. Match clothing contrast to natural contrast.",
     "style_track": ["casual", "smart_casual", "business_casual", "business_formal"]},

    {"id": "C014", "type": "must_not", "category": "color",
     "condition": {"D03.chroma": "muted"},
     "restriction": {"D03.color_temperature_in_garments": "bright_saturated"},
     "reason": "Saturated colors overpower muted/greyed-out features and draw attention away from face.",
     "style_track": ["casual", "smart_casual", "business_casual", "business_formal"]},

    {"id": "C015", "type": "must_not", "category": "occasion_formality",
     "condition": {"D07.indian_occasion_category": "indian_wedding_guest_reception"},
     "restriction": {"D04.tshirt_fit": "ANY"},
     "reason": "T-shirts are never appropriate at Indian wedding receptions. Minimum: kurta or formal shirt.",
     "style_track": ["casual"]},

    {"id": "C016", "type": "must_not", "category": "occasion_formality",
     "condition": {"D06.dress_code_level": "business_formal"},
     "restriction": {"D09.sneaker_type": "ANY"},
     "reason": "Sneakers are not appropriate for business formal settings. Minimum: leather dress shoes.",
     "style_track": ["business_formal"]},

    {"id": "C017", "type": "must_not", "category": "occasion_formality",
     "condition": {"D06.dress_code_level": "black_tie"},
     "restriction": {"D04.casual_jacket_type": "ANY"},
     "reason": "Casual jackets (bomber, denim, hoodie) are never appropriate for black tie events.",
     "style_track": ["business_formal"]},

    {"id": "C018", "type": "must", "category": "occasion_formality",
     "condition": {"D06.dress_code_level": "black_tie"},
     "restriction": {"D09.shoe_type": ["oxford_plain_cap_toe", "dress_slipper_pump"]},
     "reason": "Black tie requires patent leather or polished black Oxfords. No alternatives.",
     "style_track": ["business_formal"]},

    {"id": "C019", "type": "must", "category": "occasion_formality",
     "condition": {"D06.dress_code_level": "white_tie"},
     "restriction": {"D06.evening_wear_component_rules": "white_tie_rules"},
     "reason": "White tie has zero flexibility. Tails, white bow tie, wing collar, patent shoes. Non-negotiable.",
     "style_track": ["business_formal"]},

    {"id": "C020", "type": "must_not", "category": "occasion_formality",
     "condition": {"D07.indian_occasion_category": "corporate_office"},
     "restriction": {"D09.casual_sandal_type": ["flip_flop", "slide"]},
     "reason": "Flip-flops and slides are never appropriate in corporate office settings.",
     "style_track": ["business_casual", "business_formal"]},

    {"id": "C021", "type": "must_not", "category": "occasion_formality",
     "condition": {"D07.indian_occasion_category": "temple_visit"},
     "restriction": {"D04.shorts_type": "ANY"},
     "reason": "Shorts are inappropriate at most Indian temples. Full-length trousers required.",
     "style_track": ["casual", "smart_casual"]},

    {"id": "C022", "type": "must_not", "category": "climate",
     "condition": {"D05.indian_season_type": "monsoon"},
     "restriction": {"D09.shoe_leather_type": ["suede_reverse_calf", "calfskin"]},
     "reason": "Suede and fine leather are ruined by monsoon rain and humidity. Use waterproof/synthetic options.",
     "style_track": ["casual", "smart_casual", "business_casual"]},

    {"id": "C023", "type": "avoid", "category": "climate",
     "condition": {"D05.indian_season_type": "monsoon"},
     "restriction": {"D08.suiting_fabric": "linen"},
     "reason": "Linen absorbs moisture heavily and becomes limp in monsoon humidity. Cotton or synthetic blends preferred.",
     "style_track": ["casual", "smart_casual", "business_casual"]},

    {"id": "C024", "type": "avoid", "category": "climate",
     "condition": {"D05.indian_season_type": "peak_summer"},
     "restriction": {"D08.fabric_weight_class": "heavyweight"},
     "reason": "Heavyweight fabrics trap heat. Indian summers demand lightweight, breathable fabrics.",
     "style_track": ["casual", "smart_casual", "business_casual", "business_formal"]},

    {"id": "C025", "type": "must_not", "category": "climate",
     "condition": {"D05.climate_zone": "tropical"},
     "restriction": {"D04.hoodie_type": ["fleece", "heavyweight"]},
     "reason": "Fleece/heavyweight hoodies are impractical in tropical climates. Lightweight hoodies only if needed.",
     "style_track": ["casual"]},

    {"id": "C026", "type": "avoid", "category": "climate",
     "condition": {"D05.indian_season_type": "monsoon"},
     "restriction": {"D03.indian_summer_color_strategy": "light_reflective_summer"},
     "reason": "White and light colors show water stains and splashes during monsoon. Dark/muted colors preferred.",
     "style_track": ["casual", "smart_casual"]},

    {"id": "C027", "type": "must_not", "category": "formality_clash",
     "condition": {"D04.jacket_formality_tier": "suit_jacket"},
     "restriction": {"D09.sneaker_type": ["chunky_dad", "canvas_plimsoll", "high_top"]},
     "reason": "Chunky sneakers, canvas plimsolls, and high-tops clash with suit jacket formality.",
     "style_track": ["business_casual", "business_formal"]},

    {"id": "C028", "type": "must_not", "category": "formality_clash",
     "condition": {"D04.suit_piece_count": "three_piece"},
     "restriction": {"D09.casual_sandal_type": "ANY"},
     "reason": "Sandals of any kind with a three-piece suit is a formality violation.",
     "style_track": ["business_formal"]},

    {"id": "C029", "type": "must_not", "category": "formality_clash",
     "condition": {"D04.casual_jacket_type": "hoodie"},
     "restriction": {"D04.trouser_front": ["single_pleat", "double_pleat"]},
     "reason": "Pleated dress trousers with a hoodie is a formality mismatch.",
     "style_track": ["casual"]},

    {"id": "C030", "type": "must_not", "category": "texture_clash",
     "condition": {"D08.fabric_texture_scale": "rough_coarse"},
     "restriction": {"D08.tie_fabric": "silk_twill"},
     "reason": "Smooth silk twill tie with rough/coarse jacket texture (Harris tweed, heavy corduroy) creates dissonance. Use textured ties with textured jackets.",
     "style_track": ["smart_casual", "business_casual"]},

    {"id": "C031", "type": "must", "category": "garment_coordination",
     "condition": {"D09.belt_type": "dress_belt"},
     "restriction": {"shoe_color_match": true},
     "reason": "Belt color must match shoe color. Brown belt with black shoes is a fundamental violation. Flusser: 'Never mix leather colors.'",
     "style_track": ["smart_casual", "business_casual", "business_formal"]},

    {"id": "C032", "type": "must_not", "category": "garment_coordination",
     "condition": {},
     "restriction": {"pocket_square_matches_tie": true},
     "reason": "Matching pocket square and tie is a sign of an unsure dresser. Should coordinate but never duplicate. Flusser: 'leads the eye across the body and away from the face.'",
     "style_track": ["business_casual", "business_formal"]},

    {"id": "C033", "type": "must_not", "category": "garment_coordination",
     "condition": {},
     "restriction": {"suspenders_with_belt": true},
     "reason": "Belt and suspenders should never be worn together. Choose one support system.",
     "style_track": ["business_casual", "business_formal"]},

    {"id": "C034", "type": "must", "category": "fit_quality",
     "condition": {},
     "restriction": {"D02.fit_quality": "correct"},
     "reason": "Regardless of style track, garments must fit correctly. No pulls, puckers, X-tension, gaps. Fit trumps everything — Flusser: 'Proper fitting can do much for an inexpensive suit, while a poor fit can scuttle the expensively hand-tailored creation.'",
     "style_track": ["casual", "smart_casual", "business_casual", "business_formal"]},

    {"id": "C035", "type": "must_not", "category": "indian_wedding",
     "condition": {"D07.indian_occasion_category": "indian_wedding_guest_pheras"},
     "restriction": {"outfit_color": ["red", "white", "black"]},
     "reason": "Red is reserved for the bride, white is for mourning, black is inauspicious at Indian wedding pheras ceremony.",
     "style_track": ["casual", "smart_casual", "business_casual", "business_formal"]},

    {"id": "C036", "type": "must_not", "category": "climate",
     "condition": {"D05.indian_season_type": "peak_summer"},
     "restriction": {"D04.casual_jacket_type": ["leather_biker", "leather_bomber", "puffer"]},
     "reason": "Leather jackets and puffers are impractical in Indian peak summer heat.",
     "style_track": ["casual", "smart_casual"]},

    {"id": "C037", "type": "avoid", "category": "body_fit",
     "condition": {"D01.height": "short"},
     "restriction": {"D04.casual_trouser_fit": "wide_leg"},
     "reason": "Wide-leg trousers on short men shorten apparent leg line and add visual bulk.",
     "style_track": ["casual", "smart_casual"]},

    {"id": "C038", "type": "avoid", "category": "body_fit",
     "condition": {"D01.body_shape": "oval"},
     "restriction": {"D04.tshirt_neckline": "boat_neck"},
     "reason": "Boat neck adds horizontal emphasis on an already-wide midsection. V-neck or crew preferred for elongation.",
     "style_track": ["casual"]},

    {"id": "C039", "type": "must_not", "category": "occasion_formality",
     "condition": {"D07.indian_occasion_category": "college"},
     "restriction": {"D06.dress_code_level": "business_formal"},
     "reason": "Full business formal (suit + tie) is inappropriate and socially awkward at Indian colleges.",
     "style_track": ["business_formal"]},

    {"id": "C040", "type": "avoid", "category": "garment_coordination",
     "condition": {"D04.jeans_wash": "distressed"},
     "restriction": {"D04.jacket_formality_tier": "suit_jacket"},
     "reason": "Distressed jeans with a suit jacket is a jarring formality mismatch.",
     "style_track": ["smart_casual", "business_casual"]},

    {"id": "C041", "type": "must", "category": "indian_occasion",
     "condition": {"D07.indian_occasion_category": "temple_visit"},
     "restriction": {"footwear": "removable"},
     "reason": "Footwear must be easily removable at Indian temples. Slip-ons or sandals preferred over lace-ups.",
     "style_track": ["casual", "smart_casual"]},

    {"id": "C042", "type": "avoid", "category": "body_proportion",
     "condition": {"D01.build": "slim"},
     "restriction": {"D02.line_direction": "vertical"},
     "reason": "Slim men don't need further vertical elongation. Horizontal elements add needed visual breadth.",
     "style_track": ["casual", "smart_casual", "business_casual", "business_formal"]},

    {"id": "C043", "type": "must_not", "category": "formality_clash",
     "condition": {"D04.tshirt_style_type": "graphic"},
     "restriction": {"D06.dress_code_level": ["business_formal", "business_casual"]},
     "reason": "Graphic tees are never appropriate in business formal or business casual settings.",
     "style_track": ["business_casual", "business_formal"]},

    {"id": "C044", "type": "avoid", "category": "climate",
     "condition": {"D05.indian_season_type": "peak_summer"},
     "restriction": {"D04.jeans_stretch": "rigid"},
     "reason": "Rigid non-stretch denim is uncomfortable in Indian summer heat. Comfort stretch or lighter fabrics preferred.",
     "style_track": ["casual", "smart_casual"]},

    {"id": "C045", "type": "must_not", "category": "color",
     "condition": {"D03.flusser_complexion_type": "muted"},
     "restriction": {"D03.outfit_contrast_level": "high_outfit_contrast"},
     "reason": "Flusser: high-contrast clothing 'bullies' a muted complexion into submission. Needs softer, monotoned color format.",
     "style_track": ["casual", "smart_casual", "business_casual", "business_formal"]},

    {"id": "C046", "type": "must", "category": "garment_coordination",
     "condition": {"D04.tie_width": "ANY"},
     "restriction": {"lapel_width_match": true},
     "reason": "Tie width must approximately match lapel width. D04 width_harmony_rule: tie ≈ lapel ≈ collar spread.",
     "style_track": ["business_casual", "business_formal"]},

    {"id": "C047", "type": "must", "category": "garment_coordination",
     "condition": {"D04.tie_knot_type": "ANY"},
     "restriction": {"collar_fill_match": true},
     "reason": "Tie knot must fill the collar opening. Four-in-hand for point collars, half/full Windsor for spread. D04 knot_collar_fill principle.",
     "style_track": ["business_casual", "business_formal"]},

    {"id": "C048", "type": "must_not", "category": "occasion_formality",
     "condition": {"D07.indian_occasion_category": "indian_wedding_guest_sangeet"},
     "restriction": {"D04.jeans_fit": "ANY"},
     "reason": "Jeans are too casual for Indian wedding sangeet events. Minimum: chinos or dress trousers.",
     "style_track": ["casual"]},

    {"id": "C049", "type": "avoid", "category": "body_fit",
     "condition": {"D01.neck": "short"},
     "restriction": {"D04.tshirt_neckline": "mock_neck"},
     "reason": "Mock neck and turtleneck crowd a short neck, making it appear shorter. V-neck or crew opens the neck area.",
     "style_track": ["casual", "smart_casual"]},

    {"id": "C050", "type": "avoid", "category": "body_fit",
     "condition": {"D01.neck": "short"},
     "restriction": {"D04.shirt_collar_height": "tall"},
     "reason": "Tall collar band compresses a short neck. Low to standard height recommended.",
     "style_track": ["smart_casual", "business_casual", "business_formal"]}
  ],

  "summary": {
    "total_constraints": 50,
    "by_type": {"must": 10, "must_not": 25, "avoid": 15},
    "by_category": {
