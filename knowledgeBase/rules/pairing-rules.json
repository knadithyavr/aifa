  "anti_pairings": {
    "description": "Combinations that should NEVER be recommended regardless of scores",
    "rules": [
      {
        "combo": "denim_shirt + denim_jeans_same_wash",
        "score": 1,
        "reason": "Canadian tuxedo — different washes can work but same wash is a faux pas"
      },
      {
        "combo": "suit_jacket + jeans_distressed",
        "score": 1,
        "reason": "Formality clash — suit structure vs distressed casualness"
      },
      {
        "combo": "hoodie + dress_trousers",
        "score": 1,
        "reason": "Formality mismatch — structured bottom + unstructured casual top"
      },
      {
        "combo": "flip_flop + any_long_trouser",
        "score": 2,
        "reason": "Trousers drag over flip-flops, looks sloppy"
      },
      {
        "combo": "tshirt_graphic + chinos_dressy",
        "score": 3,
        "reason": "Graphic tee casualizes the chinos too much"
      },
      {
        "combo": "sport_sandal + polo_chinos",
        "score": 3,
        "reason": "Sport sandals are too athletic for smart casual"
      },
      {
        "combo": "high_top + shorts",
        "score": 2,
        "reason": "High-tops with shorts creates awkward ankle-to-knee proportion"
      },
      {
        "combo": "puffer_jacket + shorts",
        "score": 1,
        "reason": "Winter top + summer bottom = confused outfit"
      },
      {
        "combo": "linen_shirt + joggers",
        "score": 2,
        "reason": "Elevated top + athletic bottom — formality mismatch"
      },
      {
        "combo": "polo_slim + jeans_relaxed",
        "score": 3,
        "reason": "Fitted top + baggy bottom — silhouette clash"
      },
      {
        "combo": "oversized_tee + relaxed_jeans",
        "score": 3,
        "reason": "Everything oversized = shapeless. One loose + one fitted."
      },
      {
        "combo": "flannel_shirt + shorts",
        "score": 2,
        "reason": "Winter top + summer bottom = confused season"
      },
      {
        "combo": "chelsea_boot + shorts",
        "score": 2,
        "reason": "Boots with shorts creates awkward ankle-to-knee gap"
      },
      {
        "combo": "espadrille + jeans_bootcut",
        "score": 2,
        "reason": "Bootcut covers the espadrille — defeats the purpose"
      },
      {
        "combo": "kolhapuri + formal_trousers",
        "score": 3,
        "reason": "Traditional sandal + Western formal — cultural style mismatch"
      }
    ]
  },
